package {{packageName}}

import (
	"testing"

	"github.com/typescript-eslint/tsgolint/internal/rule_tester"
	"github.com/typescript-eslint/tsgolint/internal/rules/fixtures"
)
{{#if isGated}}

// A file inside the tree this rule judges. Every case that should report needs
// one, because the default test file name does not match defaultFiles.
const inScope = "TODO/path/inside/the/gated/tree.ts"
{{/if}}

func Test{{testName}}(t *testing.T) {
	t.Parallel()
	rule_tester.RunRuleTester(fixtures.GetRootDir(), "tsconfig.minimal.json", t, &{{ruleVar}}, []rule_tester.ValidTestCase{
{{#if isGated}}
		// The gate: outside the tree the rule reports nothing, however
		// violating the code is. Omitting FileName uses the default `file.ts`,
		// which defaultFiles does not match.
		{
			Code: `TODO: the invalid code below, unchanged`,
		},
{{/if}}
		// TODO: the near-misses. A valid case that could never report proves
		// nothing; the ones worth writing are those a careless implementation
		// would flag.
		{
			Code: `TODO`,
{{#if isGated}}
			FileName: inScope,
{{/if}}
		},
	}, []rule_tester.InvalidTestCase{
		{
			// TODO: name what this case proves, not what it contains.
			Code: `TODO`,
{{#if isGated}}
			FileName: inScope,
{{/if}}
			Errors: []rule_tester.InvalidTestCaseError{
				{MessageId: "{{messageId}}"},
			},
		},
{{#if hasOptions}}
		// The option changes what reports, so it needs its own case.
		{
			Code: `TODO`,
{{#if isGated}}
			FileName: inScope,
{{/if}}
			Options: map[string]any{"example": "TODO"},
			Errors: []rule_tester.InvalidTestCaseError{
				{MessageId: "{{messageId}}"},
			},
		},
{{/if}}
	})
}
