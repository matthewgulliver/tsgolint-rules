// lintcn:name {{name}}
// lintcn:severity {{severity}}
// lintcn:description {{description}}

package {{packageName}}

import (
	"github.com/microsoft/typescript-go/shim/ast"
	"github.com/typescript-eslint/tsgolint/internal/rule"
{{#if hasOptions}}
	"github.com/typescript-eslint/tsgolint/internal/utils"
{{/if}}
{{#if isGated}}
	"github.com/typescript-eslint/tsgolint/lintcn-rules/archkit"
{{/if}}
)
{{#if isGated}}

var defaultFiles = []string{ {{{globs}}} }
{{/if}}
{{#if hasOptions}}

type Options struct {
	Example *string `json:"example,omitempty"`
}

func (o Options) example() string {
	if o.Example == nil {
		return "TODO: the default"
	}
	return *o.Example
}
{{/if}}

func build{{testName}}Message(name string) rule.RuleMessage {
	return rule.RuleMessage{
		Id: "{{messageId}}",
		Description: "`" + name + "` TODO: what is wrong, and what it costs.",
		Help:        "TODO: the change that resolves it.",
	}
}

var {{ruleVar}} = rule.Rule{
	Name: "{{name}}",
{{#if isGated}}
	Run: archkit.Gated(defaultFiles, func(ctx rule.RuleContext, options any) rule.RuleListeners {
{{else}}
	Run: func(ctx rule.RuleContext, options any) rule.RuleListeners {
{{/if}}
{{#if hasOptions}}
		opts := utils.UnmarshalOptions[Options](options, "{{name}}")
		example := opts.example()
		_ = example
{{/if}}

		return rule.RuleListeners{
			ast.KindTypeAliasDeclaration: func(node *ast.Node) {
				declaration := node.AsTypeAliasDeclaration()
				name := declaration.Name()
				if name == nil {
					return
				}
				if !isViolation(ctx, node) {
					return
				}

				ctx.ReportNode(node, build{{testName}}Message(name.Text()))
			},
		}
{{#if isGated}}
	}),
{{else}}
	},
{{/if}}
}

func isViolation(_ rule.RuleContext, _ *ast.Node) bool {
	return false
}
